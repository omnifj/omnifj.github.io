{{- $posts := where site.RegularPages "Type" "posts" -}}
[{{- range $i, $p := $posts }}{{ if $i }},{{ end }}{"title":{{ $p.Title | jsonify }},"permalink":{{ $p.RelPermalink | jsonify }},"date":{{ $p.Date.Format "2006.01.02" | jsonify }},"summary":{{ ($p.Params.description | default ($p.Summary | plainify)) | jsonify }},"content":{{ $p.Plain | jsonify }},"tags":{{ ($p.Params.tags | default (slice)) | jsonify }},"categories":{{ ($p.Params.categories | default (slice)) | jsonify }},"readingTime":{{ $p.ReadingTime }}}{{ end -}}]
